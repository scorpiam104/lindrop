# System & Core App Config
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
API_URL=http://localhost:5000/api
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/lindrop

# Security
JWT_SECRET=replace-with-a-long-random-secret

# Platform Master App Credentials (Managed by Admins)
META_APP_ID=your-platform-meta-app-id
META_APP_SECRET=your-platform-meta-app-secret
META_GRAPH_API_VERSION=v19.0

PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxx
PAYSTACK_SUBACCOUNT_CODE=ACCT_xxxx
PAYSTACK_CASHBACK_RECIPIENT=RCP_xxxx

# OAuth Social Login (optional, per provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# OG Image Generation (Canvas Font)
CANVAS_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# WhatsApp Business (Meta) - Platform-level values (optional but recommended)
WHATSAPP_ACCESS_TOKEN=EAAX...your_whatsapp_business_token_here
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=lindrop-webhook

# Redis (optional) - job queue / cache
REDIS_URL=redis://localhost:6379

# Sentry (optional) - error tracking
SENTRY_DSN=

# Email / SMTP (optional) - transactional emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
MAIL_FROM=LinkPay <no-reply@example.com>

# Object Storage (optional) - e.g., S3 for uploads and generated media
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Feature toggles
ENABLE_AI_FEATURES=true
